  "cases": [
    {
      "id": "q1.scalar.store-after-each-op",
      "sources": [
        "quake-pr-exec",
        "quake-eval-type"
      ],
      "derivation": "At 2^24 binary32 spacing is 2. 2^24+1 is halfway and rounds to even 2^24 at the OP_ADD_F store; subtracting 2^24 then stores zero. Keeping a binary64 intermediate would incorrectly produce one.",
      "input": {
        "kind": "scalar-program",
        "initial": 16777216,
        "operations": [
          {
            "operator": "add",
            "operand": 1
          },
          {
            "operator": "subtract",
            "operand": 16777216
          }
        ]
      },
      "expected": {
        "kind": "scalar-program",
        "values": [
          16777216,
          16777216,
          0
        ],
        "bits": [
          "4b800000",
          "4b800000",
          "00000000"
        ]
      },
      "observed": {
        "kind": "scalar-program",
        "values": [
          16777216,
          16777216,
          0
        ],
        "bits": [
          "4b800000",
          "4b800000",
          "00000000"
        ]
      },
      "passed": true,
      "inputSha256": "75bc87ca2bd897844f33d1f11a62d1327ab7257c2b33df77bc71770e3a6adde4",
      "expectedSha256": "bafabffeafd087b63b4e734df07016e6e0bc06b6818a4923eecdbeece33487b6"
    },
    {
      "id": "q1.scalar.ties-round-up-to-even",
      "sources": [
        "quake-pr-exec",
        "quake-eval-type"
      ],
      "derivation": "16777218 has an odd low significand bit. Adding one reaches the midpoint and rounds to the even 16777220.",
      "input": {
        "kind": "scalar-program",
        "initial": 16777218,
        "operations": [
          {
            "operator": "add",
            "operand": 1
          }
        ]
      },
      "expected": {
        "kind": "scalar-program",
        "values": [
          16777218,
          16777220
