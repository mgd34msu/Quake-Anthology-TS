{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": false },
  "files": {
    "includes": [
      "src/**/*.ts",
      "tests/**/*.ts",
      "tools/**/*.ts",
      "!**/node_modules",
      "!**/dist",
      "!**/.artifacts",
      "!src/app/bootstrap/network/unified-event-codec.ts"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 160, "lineEnding": "lf" },
  "linter": { "enabled": false },
  "assist": { "enabled": false },
  "javascript": { "formatter": { "quoteStyle": "double", "semicolons": "always", "trailingCommas": "all", "arrowParentheses": "asNeeded" } }
}
