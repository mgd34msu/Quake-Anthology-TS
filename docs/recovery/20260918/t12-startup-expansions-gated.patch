+  expect(sameFamily.recipe.map.entities.content).toBe(catalog.require("q1-classic-id1").id);
+  expect(sameFamily.recipe.weapons).toEqual([{ provider: "q1:weapons/classic/rogue", content: catalog.require("q1-classic-rogue").id }]);
+}, 60000);
