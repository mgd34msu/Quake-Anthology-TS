+test.skipIf(process.env["QTS_TEST_INSTALLED_EXPANSION_ARSENALS"] !== "1")("startup expansion arsenal choices resolve independently and preserve the supplied world", async () => {
+  const catalog = await discoverInstalledContent({ corpusRoot: corpus, discoverMods: false });
+  const command = parseApplicationCommand(["--content-root", corpus, "--game", "q2-classic-baseq2", "--map", "base1", "--movement", "q1", "--character", "q1"]);
+  if (command.kind !== "run") throw new Error("Missing startup options");
+  const model = new StartupSelectionModel(catalog, command.options);
+  await model.prepareMaps();
+  const choices = model.rows().find(row => row.id === "weapons")?.choices;
+  if (choices === undefined) throw new Error("Missing arsenal choices");
+  expect(new Set(choices.map(choice => choice.id)).size).toBe(choices.length);
+  for (const id of ["q1-rerelease-dopa", "q1-rerelease-mg1", "q1-rerelease-mg3", "q2-rerelease-mg2"])
+    expect(choices.find(choice => choice.id === id)?.unavailable).toBeNull();
+  const cases: readonly (readonly [string, string, string])[] = [
+    ["q1-classic-rogue", "q1:weapons/classic/rogue", "q1:weapon/rogue:lava-nailgun"],
+    ["q1-rerelease-mg3", "q1:weapons/rerelease/mg3", "q1:weapon/mg3:laser"],
+    ["q2-classic-xatrix", "q2:weapons/classic/xatrix", "q2:weapon_boomer"],
+    ["q2-classic-rogue", "q2:weapons/classic/rogue", "q2:weapon_etf_rifle"],
+  ];
+  for (const [product, provider, item] of cases) {
+    model.select("weapons", product);
+    expect(model.bindingItems().some(binding => binding.id === item)).toBe(true);
+    const launch = await model.resolve();
+    expect(launch.recipe.weapons).toEqual([{ provider, content: catalog.require(product).id }]);
+    expect(launch.recipe.timing.some(timing => timing.provider === provider)).toBe(true);
+    expect(launch.recipe.map.entities).toEqual({ provider: "q2:official", content: catalog.require("q2-classic-baseq2").id });
+    expect(launch.recipe.map.geometryContent).toBe(catalog.require("q2-classic-baseq2").id);
+    expect(launch.recipe.map.geometry.requestedPath).toBe("maps/base1.bsp");
+    expect(launch.options.movement).toBe("q1");
+    expect(launch.options.character).toBe("q1");
+  }
+  model.select("weapons", "q2-rerelease-baseq2");
+  expect(model.bindingItems().some(binding => binding.id === "q2:weapon_boomer")).toBe(true);
+  expect(model.bindingItems().some(binding => binding.id === "q2:weapon_etf_rifle")).toBe(true);
+  model.select("product", "q1-classic-id1"); await model.prepareMaps();
+  model.select("map", "maps/e1m1.bsp"); model.select("weapons", "q1-classic-rogue");
