--- a/src/content/q3/base/game/proximity.ts
+++ b/src/content/q3/base/game/proximity.ts
@@ -0,0 +1,160 @@
+import type { ActorId, OwnedActor } from "../../../../contracts/identity.ts";
+import type { Vec3 } from "../../../../contracts/math.ts";
+import type { SessionActorRegistry } from "../../../../world/actors/index.ts";
+import { length3, sub3 } from "../../../../core/math.ts";
+
+export type Q3ProximityPhase = { readonly kind: "flight" }
+  | { readonly kind: "arming" | "triggered" | "retiring"; readonly due: number }
+  | { readonly kind: "armed"; readonly due: number; readonly trigger: ActorId }
+  | { readonly kind: "attached"; readonly due: number; readonly target: ActorId }
+  | { readonly kind: "spent"; readonly target: ActorId }
+  | { readonly kind: "exploded" };
+export interface Q3ProximityState {
+  phase: Q3ProximityPhase;
+  readonly team: string | null;
+  leftOwner: boolean;
+  health: number;
+}
+export interface Q3ProximityMine {
+  readonly actor: OwnedActor;
+  readonly owner: ActorId;
+  readonly proximity: Q3ProximityState;
+  splash: number;
+  radius: number;
+}
+export interface Q3ProximityPlayer {
+  readonly origin: Vec3;
+  readonly health: number;
+  readonly team: string | null;
+  readonly invulnerabilityUntil: number;
+}
+export interface Q3ProximityHost {
+  time(): number;
+  timeout(): number;
+  teamGame(): boolean;
+  origin(): Vec3;
+  player(actor: ActorId): Q3ProximityPlayer | null;
+  canDamage(actor: ActorId, origin: Vec3): boolean;
+  stick(origin: Vec3, normal: Vec3, surfaceFlags: number, target: ActorId): void;
+  activate(): ActorId;
+  releaseTrigger(actor: ActorId): void;
+  attach(actor: ActorId): void;
+  ticking(actor: ActorId, mine: ActorId | null): void;
+  trigger(): void;
+  explode(origin: Vec3 | null): void;
+  juiced(actor: ActorId): void;
+  release(): void;
+  changed(): void;
+}
+interface Entry { readonly mine: Q3ProximityMine; readonly host: Q3ProximityHost; }
+
+/** Per-world component index shared by native and foreign missile adapters. */
+export class Q3ProximityRegistry {
+  private readonly mines = new Map<ActorId, Entry>();
+  private readonly players = new Map<ActorId, ActorId>();
+  private readonly unsubscribe: () => undefined;
+  constructor(actors: Pick<SessionActorRegistry, "onRelease">) {
+    this.unsubscribe = actors.onRelease(actor => { this.released(actor.id); return undefined; });
+  }
+  close(): void { this.unsubscribe(); this.mines.clear(); this.players.clear(); }
+  bind(mine: Q3ProximityMine, host: Q3ProximityHost): void {
+    if (this.mines.has(mine.actor.id)) throw new Error("Proximity mine already registered");
+    const phase = mine.proximity.phase;
+    if (phase.kind === "attached") {
+      if (this.players.has(phase.target)) throw new Error("Player has multiple restored proximity mines");
+      this.players.set(phase.target, mine.actor.id);
+    }
+    this.mines.set(mine.actor.id, { mine, host });
+  }
+  attached(actor: ActorId): ActorId | null { return this.players.get(actor) ?? null; }
+  private entry(actor: ActorId): Entry {
+    const entry = this.mines.get(actor);
+    if (entry === undefined) throw new Error("Proximity mine is not registered in this world");
+    return entry;
+  }
+  private set(entry: Entry, phase: Q3ProximityPhase): void {
+    entry.mine.proximity.phase = phase;
+    entry.host.changed();
+  }
+  impact(actor: ActorId, target: ActorId, point: Vec3, normal: Vec3, surfaceFlags: number): void {
+    const entry = this.entry(actor), { mine, host } = entry;
+    if (mine.proximity.phase.kind !== "flight") return;
+    const player = host.player(target);
+    if (player !== null && player.health > 0) {
+      host.attach(target);
+      if (!this.mines.has(actor)) return;
+      const attached = this.players.get(target), prior = attached === undefined ? undefined : this.mines.get(attached);
+      if (prior !== undefined) {
+        prior.mine.splash = (prior.mine.splash + mine.splash) | 0;
+        prior.mine.radius = Math.fround(prior.mine.radius * Math.fround(1.5));
+        this.set(entry, { kind: "retiring", due: host.time() });
+      } else {
+        this.players.set(target, actor);
+        host.ticking(target, actor);
+        this.set(entry, { kind: "attached", target, due: (host.time() + (player.invulnerabilityUntil > host.time() ? 2000 : 10000)) | 0 });
+      }
+      return;
+    }
+    host.stick(point, normal, surfaceFlags, target);
+    if (this.mines.has(actor)) this.set(entry, { kind: "arming", due: (host.time() + 2000) | 0 });
+  }
+  killed(actor: ActorId): void {
+    const entry = this.entry(actor), phase = entry.mine.proximity.phase;
+    if (phase.kind === "exploded" || phase.kind === "retiring" || phase.kind === "spent") return;
+    if (phase.kind === "armed") entry.host.releaseTrigger(phase.trigger);
+    this.set(entry, { kind: "triggered", due: (entry.host.time() + 1) | 0 });
+  }
+  touch(actor: ActorId, target: ActorId): void {
+    const entry = this.entry(actor), { mine, host } = entry, phase = mine.proximity.phase;
+    if (phase.kind !== "armed") return;
+    const player = host.player(target);
+    if (player === null || length3(sub3(host.origin(), player.origin)) > mine.radius
+      || host.teamGame() && mine.proximity.team === player.team || !host.canDamage(target, host.origin())) return;
+    this.set(entry, { kind: "triggered", due: (host.time() + 500) | 0 });
+    host.trigger();
+    host.releaseTrigger(phase.trigger);
+  }
+  think(actor: ActorId): void {
+    const entry = this.entry(actor), { mine, host } = entry, phase = mine.proximity.phase;
+    if (phase.kind === "flight" || phase.kind === "spent" || phase.kind === "exploded" || phase.due > host.time()) return;
+    switch (phase.kind) {
+      case "arming": {
+        mine.proximity.health = 1;
+        const trigger = host.activate();
+        if (this.mines.has(actor)) this.set(entry, { kind: "armed", due: (host.time() + host.timeout()) | 0, trigger });
+        return;
+      }
+      case "retiring": host.release(); return;
+      case "attached": {
+        const player = host.player(phase.target);
+        if (player === null) { host.release(); return; }
+        this.players.delete(phase.target); host.ticking(phase.target, null);
+        if (player.invulnerabilityUntil > host.time()) {
+          this.set(entry, { kind: "spent", target: phase.target });
+          host.juiced(phase.target);
+        } else {
+          this.set(entry, { kind: "exploded" }); host.explode(player.origin);
+        }
+        return;
+      }
+      case "armed":
+        this.set(entry, { kind: "exploded" }); host.explode(null); host.releaseTrigger(phase.trigger); return;
+      case "triggered": this.set(entry, { kind: "exploded" }); host.explode(null); return;
+    }
+  }
+  private released(actor: ActorId): void {
+    const entry = this.mines.get(actor);
+    if (entry !== undefined) {
+      this.mines.delete(actor);
+      const phase = entry.mine.proximity.phase;
+      if (phase.kind === "attached" || phase.kind === "spent") {
+        if (this.players.get(phase.target) === actor) { this.players.delete(phase.target); entry.host.ticking(phase.target, null); }
+      } else if (phase.kind === "armed") entry.host.releaseTrigger(phase.trigger);
+    }
+    for (const { mine, host } of [...this.mines.values()]) {
+      const phase = mine.proximity.phase;
+      if ((phase.kind === "attached" || phase.kind === "spent") && phase.target.equals(actor)) host.release();
+      else if (phase.kind === "armed" && phase.trigger.equals(actor)) this.set({ mine, host }, { kind: "triggered", due: phase.due });
+    }
+  }
+}
