{
  "name": "quake-typescript",
  "version": "1.2.8-dev",
  "private": true,
  "type": "module",
  "license": "GPL-2.0-or-later",
  "scripts": {
    "start": "bun run src/main.ts",
    "dev": "bun run src/main.ts",
    "typecheck": "tsc --noEmit",
    "policy": "bun run tools/check-policy.ts",
    "test": "bun test",
    "test:unit": "bun tools/test-tier.ts unit",
    "test:corpus": "bun tools/test-tier.ts corpus",
    "test:gl": "bun tools/test-tier.ts gl",
    "test:policy": "bun test tests/policy",
    "test:platform": "bun test tests/platform",
    "bench:foundation": "bun run tools/bench-foundation.ts",
    "check": "bun run typecheck && bun run format:check && bun run spdx && bun run codec:check && bun run policy",
    "build": "bun run tools/build.ts",
    "build:tools": "bun run tools/build.ts --tools",
    "release": "bun run tools/release.ts",
    "format": "biome format --write",
    "format:check": "biome format",
    "spdx": "bun tools/check-spdx.ts",
    "codec:generate": "bun tools/generate-event-codec.ts",
    "codec:check": "bun tools/generate-event-codec.ts --check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "packageManager": "bun@1.3.14"
}
